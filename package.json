{
  "name": "cuyo-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "dev": "vite",
    "build:levels": "node --experimental-transform-types --disable-warning=ExperimentalWarning levels-src/validate-levels.ts",
    "build": "npm run build:levels && tsc --noEmit && vite build",
    "build:terse": "npm run build:levels && tsc --noEmit --pretty false && vite build --logLevel warn",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:docs": "bash scripts/lint-docs.sh",
    "lint:specs": "openspec validate --strict --all",
    "lint:shell": "shellcheck scripts/*.sh",
    "check:art": "bash scripts/check-no-upstream-art.sh",
    "fetch:corpus": "bash scripts/fetch-cuyo.sh",
    "typecheck": "tsc --noEmit",
    "dev:lan": "vite --port 5173 --strictPort --host",
    "lint:workflows": "node scripts/check-workflows.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.14.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "actionlint": "^2.0.6",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "30.1.2",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
