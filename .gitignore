# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local-only context: upstream Cuyo source, AI memory, notes, plans.
# The directory and its own .gitignore are tracked so it exists on a fresh
# clone; everything inside it is not.
.context/*

# Environment
.env
.env.local
*.local

#AI
.caim

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Generated: the upstream .ld files the browser fetches at runtime, copied by
# scripts/copy-level-data.sh from the local-only upstream tree.
public/levels/
